# ── Server ────────────────────────────────────────────────────────
# Use 8001 for local Node development to avoid common IDE/proxy conflicts on 8000.
# Docker Compose overrides this to 8000 inside the backend container.
PORT=8001

# ── Database ──────────────────────────────────────────────────────
# Local backend connecting to the Docker Compose database
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=kemps_root_pass
DB_NAME=kemps_inventory
# Maximum database connections in pool
DB_CONNECTION_LIMIT=10

# Backend running inside Docker (provided automatically by docker-compose.yml)
# DB_HOST=db
# DB_PORT=3306
# DB_PASSWORD=kemps_root_pass

# ── Authentication ────────────────────────────────────────────────
JWT_SECRET=change_this_for_production

# Comma-separated list of allowed origins.
# Localhost and the Cloudflare frontend domain are allowed by default in code.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security & Rate Limiting ─────────────────────────────────────────
# Rate limit window in milliseconds (e.g., 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Maximum number of login requests per window from a single IP
RATE_LIMIT_MAX=5
