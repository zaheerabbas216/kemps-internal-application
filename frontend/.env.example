# ── API Base URL ──────────────────────────────────────────────────
# Local development (node server.js uses port 8001)
VITE_API_BASE_URL=http://localhost:8001/api

# Docker (backend exposed on host port 8000)
# VITE_API_BASE_URL=http://localhost:8000/api

# Cloudflare Tunnel production
# VITE_API_BASE_URL=https://kmps-bkend-fullstack-application.bitwizard.online/api

# Do not add VAPID_PRIVATE_KEY here. Vite variables are bundled into public
# browser code. The public VAPID key is fetched from the backend at runtime.
